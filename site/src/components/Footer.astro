---
import Default from '@astrojs/starlight/components/Footer.astro';

import ContactCTA from './site-contact/ContactCTA.astro';
import SiteFooter from './site-footer/SiteFooter.astro';
import { ctaText, isSkillPage } from './cta-text';

// The hero (Hero.astro) and skill pages (middleware.ts) place the call to
// action higher up; every other page gets it at the end.
const splash = Astro.locals.starlightRoute.entry.data.template === 'splash';
const atEnd = !splash && !isSkillPage(Astro.url.pathname);
---

{atEnd && <ContactCTA text={ctaText} cta="page-end" />}

<Default {...Astro.props}>
  <slot />
</Default>

<SiteFooter />
